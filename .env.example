# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required: Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_actual_api_key_here

# Required in production: random secret used to sign sessions/CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# If left unset, the app generates a random one at startup, but it changes on
# every restart, so all sessions are invalidated each time you redeploy.
SECRET_KEY=

# Set to "true" only for local development. Must stay unset/false in any
# deployment reachable outside your own machine.
FLASK_DEBUG=false

# --- Optional: only needed once you run `docker compose up` (see docker-compose.yml) ---
# Leave both unset to keep using the default local SQLite file + filesystem
# sessions + in-memory rate limiting (fine for a single-container/demo deploy,
# but state does not survive a redeploy and does not share across replicas).

# Password for the bundled Postgres service in docker-compose.yml.
POSTGRES_PASSWORD=change_me

# Only needed if you're running the app directly (not via docker compose),
# against your own Postgres/Redis instances:
# DATABASE_URL=postgresql://user:password@host:5432/zyviora
# REDIS_URL=redis://host:6379/0

# --- Optional: only for a real public deployment behind a TLS-terminating
# reverse proxy (Caddy/nginx/Traefik) — see deploy/Caddyfile.example.
# Leave both false for local/docker-compose use over plain HTTP; turning
# SESSION_COOKIE_SECURE on without an actual HTTPS proxy in front breaks
# every login, since browsers never send a Secure cookie over plain HTTP.
# BEHIND_PROXY=true
# SESSION_COOKIE_SECURE=true

# Optional: adjust log verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# LOG_LEVEL=INFO

# --- Optional: needed for "forgot password" emails to actually send.
# Left unset, the reset link is logged instead of emailed (see send_email in
# app.py) — the whole flow works end-to-end for local testing without this,
# but real users obviously need a real email in their inbox.
# Works with any SMTP provider: a Gmail account with an app password
# (https://myaccount.google.com/apppasswords), or the SMTP relay from
# SendGrid/Mailgun/Brevo/etc. Example values shown are for Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_address@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM=your_address@gmail.com

# --- Optional: needed for "teach me X" / "resources for X" in chat to
# return real, clickable video results instead of a plain YouTube search
# link fallback. Free tier (10,000 units/day, a search costs 100) — no
# billing account required. Get one at
# https://console.cloud.google.com/apis/credentials after enabling
# "YouTube Data API v3" on a Google Cloud project.
# YOUTUBE_API_KEY=your_actual_api_key_here
